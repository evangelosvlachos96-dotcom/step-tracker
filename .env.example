# Copy this file to .env and fill in real values for local development.
# .env holds secrets and is NOT committed; this .env.example IS committed
# so contributors know which variables the project needs.
#
# Generate a fresh SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Django cryptographic signing key. Required. Keep secret in production.
SECRET_KEY=

# True for local development, False (or unset) in production.
DEBUG=False

# Comma-separated list of hosts/domains the site can serve.
# Example for local dev: localhost,127.0.0.1
ALLOWED_HOSTS=
